# ============================================================
# Variáveis do app (prefixo VITE_). No Netlify: Site configuration > Environment variables.
# ============================================================

# Banco de dados. SEM estas duas, o sistema abre em MODO DEMONSTRAÇÃO, com o
# rebanho de exemplo guardado no navegador de cada visitante.
# VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# VITE_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICAVEL_ANON

# Marca exibida. O padrão vem do brand.config.json do repositório.
#   achilles -> Achilles · Gestão Agropecuária
#   fazenda  -> nome da fazenda (VITE_FARM_NAME) com a identidade verde e dourada
# VITE_BRAND=fazenda
# VITE_FARM_NAME=Fazenda Pântano

# ============================================================
# Variáveis das funções de servidor (netlify/functions). Nunca vão para o navegador.
# ============================================================

# Leitura do brinco e leitura de folha por IA. Sem ela, a demonstração mostra
# uma leitura simulada (e avisa); com banco ligado, a tela pede a configuração.
# GEMINI_API_KEY=sua_chave_do_google_ai_studio
# GEMINI_MODEL=gemini-3.6-flash

# Gestão de contas pela tela (criar, trocar senha, excluir), só com banco ligado.
# SUPABASE_SERVICE_ROLE_KEY=sua_service_role

# ============================================================
# Assistente de campo pelo WhatsApp (docs/WHATSAPP.md tem o passo a passo)
# ============================================================

# IA que interpreta as mensagens e responde perguntas (console da Anthropic).
# ANTHROPIC_API_KEY=sk-ant-...
# Modelo: claude-sonnet-5-5 (padrão), claude-haiku-5-5 (mais barato), claude-opus-5-5 (mais forte).
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_EFFORT=low

# A transcrição dos áudios usa a GEMINI_API_KEY acima. Modelo próprio, se quiser:
# GEMINI_AUDIO_MODEL=gemini-3.6-flash

# WhatsApp Cloud API (painel de desenvolvedor da Meta).
# WHATSAPP_TOKEN=token_permanente_do_usuario_do_sistema
# WHATSAPP_PHONE_NUMBER_ID=id_do_numero
# WHATSAPP_VERIFY_TOKEN=uma_senha_que_voce_inventa
# WHATSAPP_APP_SECRET=segredo_do_app
# Opcional: modelo "utilidade" aprovado, com um parâmetro, para avisos fora da janela de 24 h.
# WHATSAPP_TEMPLATE_AVISO=aviso_fazenda

# O servidor do WhatsApp usa a SUPABASE_SERVICE_ROLE_KEY acima e a SUPABASE_URL:
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
