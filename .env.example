VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICAVEL_ANON

# Nome exibido no sistema quando conectado ao banco. Sem esta variavel: Fazenda Pantano.
# Sem Supabase (modo demonstracao) o sistema aparece como Achilles Gestao Pecuaria.
# VITE_FARM_NAME=Fazenda Pantano

# Opcional. Somente se a Edge Function de leitura do brinco estiver em outro
# endereco. Sem esta variavel, o app usa:
# {VITE_SUPABASE_URL}/functions/v1/analisar-foto
# VITE_AI_FUNCTION_URL=https://SEU-PROJETO.supabase.co/functions/v1/analisar-foto

# A chave do Gemini NAO entra aqui. Ela fica somente no servidor, com:
# supabase secrets set GEMINI_API_KEY=...
