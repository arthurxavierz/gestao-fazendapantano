# ============================================================
# Variáveis do app (prefixo VITE_). No Netlify: Site configuration > Environment variables.
# ============================================================

# Banco de dados. SEM estas duas, o sistema abre em MODO DEMONSTRAÇÃO, com o
# rebanho de exemplo guardado no navegador de cada visitante.
# VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# VITE_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICAVEL_ANON

# Marca exibida. O padrão vem do brand.config.json do repositório.
#   achilles -> Achilles · Gestão Agropecuária
#   fazenda  -> nome da fazenda (VITE_FARM_NAME) com a identidade verde e dourada
# VITE_BRAND=fazenda
# VITE_FARM_NAME=Fazenda Pântano

# ============================================================
# Variáveis das funções de servidor (netlify/functions). Nunca vão para o navegador.
# ============================================================

# Leitura do brinco e leitura de folha por IA. Sem ela, a demonstração mostra
# uma leitura simulada (e avisa); com banco ligado, a tela pede a configuração.
# GEMINI_API_KEY=sua_chave_do_google_ai_studio
# GEMINI_MODEL=gemini-3.6-flash

# Gestão de contas pela tela (criar, trocar senha, excluir), só com banco ligado.
# SUPABASE_SERVICE_ROLE_KEY=sua_service_role
